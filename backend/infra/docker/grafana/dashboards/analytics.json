      "pluginVersion": "10.0.0",
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT j.title as \"Job Title\", COUNT(a.id) as \"Applications\" FROM jobs j LEFT JOIN applications a ON j.id = a.job_id GROUP BY j.id, j.title ORDER BY COUNT(a.id) DESC LIMIT 5;",
          "refId": "A"
