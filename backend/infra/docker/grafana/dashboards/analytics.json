          "format": "time_series",
          "rawSql": "SELECT DATE_TRUNC('day', created_at) AS \"time\", COUNT(*) AS \"New Applications\" FROM applications WHERE created_at >= NOW() - INTERVAL '30 days' GROUP BY 1 ORDER BY 1 ASC;",
