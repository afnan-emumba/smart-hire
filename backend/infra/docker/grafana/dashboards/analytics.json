        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT (COALESCE((SELECT COUNT(*) FROM jobs WHERE publishing_failed_at IS NOT NULL), 0) + COALESCE((SELECT COUNT(*) FROM applications WHERE workflow_failed_at IS NOT NULL), 0) + COALESCE((SELECT COUNT(*) FROM event_processing_records WHERE status = 'failed'), 0) + COALESCE((SELECT COUNT(*) FROM outbox_events WHERE publish_status = 'failed'), 0))::int as value;",
          "refId": "A"
        }
      ],
      "title": "Failed Workflows/Errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres" },
