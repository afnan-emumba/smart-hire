          "format": "table",
          "rawSql": "SELECT ROUND(((COUNT(CASE WHEN status = 'interview' OR interview_started_at IS NOT NULL THEN 1 END)::numeric / NULLIF(COUNT(*), 0)) * 100), 1) as value FROM applications;",
          "refId": "A"
        }
      ],
      "title": "App-to-Interview Rate (%)",
      "type": "stat"
    },
