DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@postgres:5432/smarthire
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_BYTES=10485760
JD_UPLOAD_DIR=uploads/job_descriptions
MAX_JD_SIZE_BYTES=10485760
MAX_APPLICATIONS_PER_CANDIDATE=5
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1