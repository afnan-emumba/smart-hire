              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@example.com\",\n  \"name\": \"Software Developer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/candidates",
              "host": ["{{baseUrl}}"],
              "path": ["candidates"]
            }
          }
        },
        {
          "name": "Get Candidate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        },
        {
          "name": "List Candidates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["candidates"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Update Candidate",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        },
        {
          "name": "Delete Candidate",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job",
          "description": "Creates a draft job with minimal required data. Job description data must be extracted from uploaded PDF, not manual text.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job created as draft', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('draft');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"employment_type\": \"full_time\",\n  \"seniority_level\": \"mid\",\n  \"department\": \"Engineering\",\n  \"location\": {\n    \"city\": \"Lahore\",\n    \"country\": \"Pakistan\",\n    \"remote_policy\": \"hybrid\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        },
        {
          "name": "Upload Job Description PDF",
          "description": "Uploads and extracts job description data from PDF. This replaces manual text input. The system extracts breakdown, required skills, and other metadata from the PDF.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job description file uploaded', function () {",
                  "    pm.expect(pm.response.code).to.equal(202);",
                  "});",
                  "pm.test('Job has description breakdown from PDF', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('description_breakdown');",
                  "    pm.expect(body).to.have.property('jd_parsing_status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "description_file",
                  "type": "file",
                  "src": [],
                  "disabled": false
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/description-file",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "description-file"]
            }
          }
        },
        {
          "name": "Get Job",
          "description": "Retrieves job details including extracted breakdown from PDF.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job retrieved successfully', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Job has extracted breakdown and parsing status', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('description_breakdown');",
                  "    pm.expect(body).to.have.property('jd_parsing_status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Update Job",
          "description": "Update job metadata.",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Backend Engineer\",\n  \"seniority_level\": \"senior\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Publish Job",
          "description": "Publishes a recruiter job and starts the event-driven path. Follow this request with analytics, metrics, and Temporal checks.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Publish returns accepted response', function () {",
                  "    pm.expect(pm.response.code).to.equal(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('workflowId', body.workflow_id);",
                  "pm.test('Publish response includes workflow id', function () {",
                  "    pm.expect(body.workflow_id).to.be.a('string').and.not.empty;",
                  "    pm.expect(['processing', 'ready']).to.include(body.status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "publish"]
            }
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Create Application",
          "description": "Creates an application for a published job and triggers the application event flow. Resume data must be uploaded separately from PDF, not included in request body.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('applicationId', body.id);",
                  "pm.test('Application is pending', function () {",
                  "    pm.expect(body.status).to.equal('pending');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{jobId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Upload Resume PDF",
          "description": "Uploads and extracts resume data from PDF. This replaces manual resume text input. The system extracts skills, experience, education, and other metadata from the PDF.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resume upload accepted', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Resume extracted from PDF', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('resume_id');",
                  "    pm.expect(body).to.have.property('resume');",
                  "    pm.expect(body.metadata).to.have.property('resume_parsing');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resume",
                  "type": "file",
                  "src": [],
                  "disabled": false
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/resume",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "resume"]
            }
          }
        },
        {
          "name": "Get Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application retrieved', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Application has resume data from PDF', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('resume');",
                  "    pm.expect(body).to.have.property('metadata');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "List Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "List Applications by Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?status=pending&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Update Application Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recruiter can move application to screening', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('screening');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"screening\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "status"]
            }
          }
        },
        {
          "name": "Create Duplicate Application",
          "description": "Verifies that duplicate application submissions are rejected (409 Conflict).",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate application rejected', function () {",
                  "    pm.expect(pm.response.code).to.equal(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{jobId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics Summary",
          "description": "Returns the analytics summary backed directly by transactional tables and durable failure records.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Analytics summary is available', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Analytics summary includes required Part A metrics', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('total_candidates');",
                  "    pm.expect(body).to.have.property('total_recruiters');",
                  "    pm.expect(body).to.have.property('total_jobs_published');",
                  "    pm.expect(body).to.have.property('new_applications_over_time');",
                  "    pm.expect(body).to.have.property('application_to_interview_rate');",
                  "    pm.expect(body).to.have.property('average_time_to_hire_seconds');",
                  "    pm.expect(body).to.have.property('most_applied_jobs');",
                  "    pm.expect(body).to.have.property('average_applications_per_candidate');",
                  "    pm.expect(body).to.have.property('failed_workflows_system_errors');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/summary",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "summary"]
            }
          }
        }
      ]
    },
    {
      "name": "Temporal UI",
      "description": "Manual verification folder for workflow inspection.",
      "item": [
