{
  "info": {
    "name": "SmartHire Backend Validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API validation flow for SmartHire."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "temporalUiUrl", "value": "http://localhost:8080" },
    { "key": "recruiterUserId", "value": "{{$randomUUID}}" },
    { "key": "candidateUserId", "value": "{{$randomUUID}}" },
    { "key": "recruiterId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "candidateId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "jobId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "workflowId", "value": "pending-workflow-id" },
    { "key": "applicationId", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health endpoint is up', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Metrics Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Metrics endpoint is up', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Week 3 counters are exposed', function () {",
                  "    pm.expect(pm.response.text()).to.include('jobs_published_total');",
                  "    pm.expect(pm.response.text()).to.include('applications_received_total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["metrics"]
            }
          }
        }
      ]
    },
    {
      "name": "Recruiters",
      "item": [
        {
          "name": "Create Recruiter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recruiter created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('recruiterId', body.id);",
                  "pm.collectionVariables.set('recruiterUserId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@example.com\",\n  \"name\": \"HR Manager\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recruiters",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters"]
            }
          }
        },
        {
          "name": "Get Recruiter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recruiters/{{recruiterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters", "{{recruiterId}}"]
            }
          }
        },
        {
          "name": "List Recruiters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recruiters?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Candidates",
      "item": [
        {
          "name": "Create Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('candidateId', body.id);",
                  "pm.collectionVariables.set('candidateUserId', body.id);"
                ]
              }
            }
