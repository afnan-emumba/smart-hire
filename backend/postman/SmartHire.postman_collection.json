{
  "info": {
    "name": "SmartHire Backend Validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API validation flow for SmartHire."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "temporalUiUrl", "value": "http://localhost:8080" },
    { "key": "recruiterUserId", "value": "{{$randomUUID}}" },
    { "key": "candidateUserId", "value": "{{$randomUUID}}" },
    { "key": "recruiterId", "value": "" },
    { "key": "candidateId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "workflowId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health endpoint is up', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Setup Data",
      "item": [
        {
          "name": "Create Recruiter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recruiter created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('recruiterId', body.id);",
                  "pm.collectionVariables.set('recruiterUserId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@example.com\",\n  \"name\": \"HR Manager\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recruiters",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters"]
            }
          }
        },
        {
          "name": "Create Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('candidateId', body.id);",
                  "pm.collectionVariables.set('candidateUserId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@example.com\",\n  \"name\": \"Software Developer\",\n  \"master_profile_data\": {\n    \"summary\": \"Backend engineer with experience building async APIs and workflow integrations.\",\n    \"skills\": [\"Python\", \"SQL\", \"Docker\"],\n    \"contact\": {\n      \"phone\": \"+1-555-0198\",\n      \"location\": \"Islamabad, PK\"\n    },\n    \"education\": [\n      {\n        \"institution\": \"State University\",\n        \"degree\": \"BSc\",\n        \"field_of_study\": \"Computer Science\",\n        \"start_year\": 2018,\n        \"end_year\": 2022\n      }\n    ],\n    \"work_experience\": [\n      {\n        \"company\": \"Acme Corp\",\n        \"title\": \"Software Engineer\",\n        \"start_year\": 2022,\n        \"end_year\": 2024,\n        \"description\": \"Built recruiter and candidate workflow APIs.\"\n      }\n    ],\n    \"links\": {\n      \"linkedin\": \"https://www.linkedin.com/in/example\",\n      \"github\": \"https://github.com/example\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/candidates",
              "host": ["{{baseUrl}}"],
              "path": ["candidates"]
            }
          }
        },
        {
          "name": "Get Recruiter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recruiters/{{recruiterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters", "{{recruiterId}}"]
            }
          }
        },
        {
          "name": "Get Candidate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Job Publishing Workflow",
      "item": [
        {
          "name": "Create Job",
          "description": "Creates a draft job using recruiter-bound auth context. The request intentionally omits recruiter_id and status because both are server-controlled.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job created as draft', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('draft');",
                  "    pm.expect(body).to.have.property('description_breakdown');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"description\": \"Location: Hybrid (Lahore, Pakistan)\\nJob Type: Full-Time\\nDepartment: Engineering\\nJob Description\\nWe are looking for a Backend Engineer to design reliable APIs and workflow-driven services.\\n\\n## Responsibilities\\n- Build async backend services with FastAPI and PostgreSQL.\\n- Own integrations with Temporal and Docker-based development workflows.\\n\\n## Requirements\\n- 3+ years of experience in backend engineering.\\n- Strong Python and SQL experience.\\n- Experience with Docker and service-oriented systems.\\n\\n## Benefits\\n- Health insurance\\n- Flexible hybrid schedule\",\n  \"employment_type\": \"full_time\",\n  \"seniority_level\": \"mid\",\n  \"department\": \"Engineering\",\n  \"job_category\": \"Backend Engineering\",\n  \"location\": {\n    \"city\": \"Lahore\",\n    \"country\": \"Pakistan\",\n    \"remote_policy\": \"hybrid\"\n  },\n  \"years_of_experience_required\": 3,\n  \"required_skills\": [\"Python\", \"SQL\", \"Docker\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        },
        {
          "name": "Upload Job Description File",
          "description": "Optional validation path for PDF-backed job descriptions. Use this only when you want to test jd_parsing_status moving from pending to processing through the Temporal workflow.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "description_file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/description-file",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "description-file"]
            }
          }
        },
        {
          "name": "Publish Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Publish returns accepted response', function () {",
                  "    pm.expect(pm.response.code).to.equal(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('workflowId', body.workflow_id);",
                  "pm.test('Publish response includes workflow id', function () {",
                  "    pm.expect(body.workflow_id).to.be.a('string').and.not.empty;",
                  "    pm.expect(['processing', 'ready']).to.include(body.status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "publish"]
            }
          }
        },
        {
          "name": "Get Job",
          "description": "Run this after Publish Job to verify that the job reaches ready state and that the normalized breakdown remains available.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job retrieved successfully', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Job has workflow-ready fields', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(['processing', 'ready']).to.include(body.status);",
                  "    pm.expect(body).to.have.property('description_breakdown');",
                  "    pm.expect(body).to.have.property('jd_parsing_status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Application Workflow",
      "item": [
        {
          "name": "Create Application",
          "description": "Creates an application only after the job is publishable. The candidate identity is taken from X-User-ID, and the response metadata includes the eligibility result used during creation.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('applicationId', body.id);",
                  "pm.test('Application is pending with eligibility metadata', function () {",
                  "    pm.expect(body.status).to.equal('pending');",
                  "    pm.expect(body.metadata).to.have.property('eligibility_result');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{jobId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Create Duplicate Application",
          "description": "Replays the same application request to verify duplicate protection. The implemented service raises 409 Conflict for duplicate submissions.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate application rejected', function () {",
                  "    pm.expect(pm.response.code).to.equal(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{jobId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "List Pending Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?status=pending&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Upload Application Resume",
          "description": "Uploads a PDF resume to the application. Resume parsing is validated as a Week 2 workflow side effect, but full candidate scoring remains out of scope until Week 3.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resume upload accepted', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Resume snapshot returned', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.resume_id).to.be.a('string');",
                  "    pm.expect(body.resume).to.be.an('object');",
                  "    pm.expect(body.metadata).to.have.property('resume_parsing');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "resume", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/resume",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "resume"]
            }
          }
        },
        {
          "name": "Get Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application retrieved', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Application shows workflow metadata', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.metadata).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "Update Application Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recruiter can move application to screening', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('screening');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"screening\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "status"]
            }
          }
        },
        {
          "name": "List Screening Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?status=screening&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "status", "value": "screening" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Temporal UI Inspection",
      "description": "Manual verification folder for Day 5. Use the stored workflowId to inspect the job publishing workflow in the Temporal UI.",
      "item": [
        {
          "name": "Temporal UI Root",
          "description": "Open the Temporal UI and search for the workflow stored in {{workflowId}}. Confirm the workflow history contains the publish activities and no unresolved failures.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{temporalUiUrl}}",
              "host": ["{{temporalUiUrl}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Delete Candidate",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        }
      ]
    }
  ]
}
