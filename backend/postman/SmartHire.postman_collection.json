{
  "info": {
    "name": "SmartHire Backend Validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API validation flow for SmartHire."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    {
      "key": "recruiterUserId",
      "value": "{{$randomUUID}}"
    },
    {
      "key": "candidateUserId",
      "value": "{{$randomUUID}}"
    },
    { "key": "recruiterId", "value": "" },
    { "key": "candidateId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "recruiters",
      "item": [
        {
          "name": "Create Recruiter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('recruiterId', body.id);",
                  "pm.collectionVariables.set('recruiterUserId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"recruiter@example.com\",\n  \"name\": \"Manual Recruiter\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recruiters",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters"]
            }
          }
        },
        {
          "name": "List Recruiters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recruiters?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Recruiter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recruiters/{{recruiterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters", "{{recruiterId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "candidates",
      "item": [
        {
          "name": "Create Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('candidateId', body.id);",
                  "pm.collectionVariables.set('candidateUserId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@example.com\",\n  \"name\": \"Manual Candidate\",\n  \"master_profile_data\": {\n    \"personal_info\": {\n      \"phone\": \"+1-555-0198\"\n    },\n    \"master_profile\": {\n      \"summary\": \"Aggregated profile based on prior applications.\",\n      \"top_skills\": [\"Python\", \"FastAPI\", \"PostgreSQL\"]\n    },\n    \"application_history\": []\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/candidates",
              "host": ["{{baseUrl}}"],
              "path": ["candidates"]
            }
          }
        },
        {
          "name": "List Candidates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["candidates"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Candidate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        },
        {
          "name": "Update Candidate",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manual Candidate Updated\",\n  \"master_profile_data\": {\n    \"personal_info\": {\n      \"phone\": \"+1-555-0100\"\n    },\n    \"master_profile\": {\n      \"summary\": \"Updated aggregate profile for recruiter search and matching.\",\n      \"top_skills\": [\"Python\", \"FastAPI\", \"System Design\"]\n    },\n    \"application_history\": []\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "jobs",
      "item": [
        {
          "name": "Create Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"description\": \"Own async backend services and hiring workflows.\",\n  \"required_skills\": [\"python\", \"fastapi\", \"postgresql\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Job",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"published\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "applications",
      "item": [
        {
          "name": "Create Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('applicationId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{jobId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "List Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Application",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "Upload Application Resume",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "resume", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/resume",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "resume"]
            }
          }
        }
      ]
    },
    {
      "name": "cleanup",
      "item": [
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Delete Candidate",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        }
      ]
    }
  ]
}
