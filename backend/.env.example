# Backend Application Configuration
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/smarthire
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_JOB_TASK_QUEUE=job-publishing
TEMPORAL_APPLICATION_TASK_QUEUE=candidate-application
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_JOB_PUBLISHED_TOPIC=smarthire.jobs.published.v1
KAFKA_APPLICATION_RECEIVED_TOPIC=smarthire.applications.received.v1
RABBITMQ_URL=amqp://smarthire:smarthire@localhost:5672/
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://smarthire:smarthire@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/0
LOG_LEVEL=INFO
METRICS_ENABLED=true
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_BYTES=10485760
JD_UPLOAD_DIR=uploads/job_descriptions
MAX_JD_SIZE_BYTES=10485760
MAX_APPLICATIONS_PER_CANDIDATE=5

# Python Runtime Flags
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
