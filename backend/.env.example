# Backend Application Configuration
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@your_postgres_host:5432/smarthire
TEMPORAL_ADDRESS=your_temporal_host:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_JOB_TASK_QUEUE=job-publishing
TEMPORAL_APPLICATION_TASK_QUEUE=candidate-application
KAFKA_BOOTSTRAP_SERVERS=your_kafka_host:29092
SCHEMA_REGISTRY_URL=http://your_schema_registry_host:8081
KAFKA_JOB_PUBLISHED_TOPIC=smarthire.jobs.published.v1
KAFKA_APPLICATION_RECEIVED_TOPIC=smarthire.applications.received.v1
KAFKA_CONSUMER_GROUP_ID=smarthire-consumer
KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
EVENT_RELAY_BATCH_SIZE=50
EVENT_RELAY_POLL_INTERVAL_SECONDS=2
EVENT_RELAY_MAX_RETRIES=5
EVENT_RELAY_RETRY_BACKOFF_SECONDS=5
RABBITMQ_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@your_rabbitmq_host:5672/
REDIS_URL=redis://your_redis_host:6379/0
CELERY_BROKER_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@your_rabbitmq_host:5672/
CELERY_RESULT_BACKEND=redis://your_redis_host:6379/0
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF=2
LOG_LEVEL=INFO
METRICS_ENABLED=true
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-otel-collector-host:4317

# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_BYTES=10485760
JD_UPLOAD_DIR=uploads/job_descriptions
MAX_JD_SIZE_BYTES=10485760
MAX_APPLICATIONS_PER_CANDIDATE=5

# Python Runtime Flags
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
