# PostgreSQL Configuration
POSTGRES_DB=smarthire
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# Kafka and Schema Registry
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_HOST_PORT=29092
KAFKA_ADVERTISED_HOST=your-kafka-advertised-host
SCHEMA_REGISTRY_HOST_PORT=8081
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_JOB_PUBLISHED_TOPIC=smarthire.jobs.published.v1
KAFKA_APPLICATION_RECEIVED_TOPIC=smarthire.applications.received.v1
KAFKA_CONSUMER_GROUP_ID=smarthire-consumer
KAFKA_CONSUMER_POLL_TIMEOUT_MS=1000
EVENT_RELAY_BATCH_SIZE=50
EVENT_RELAY_POLL_INTERVAL_SECONDS=2
EVENT_RELAY_MAX_RETRIES=5
EVENT_RELAY_RETRY_BACKOFF_SECONDS=5

# RabbitMQ and Redis
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
REDIS_HOST_PORT=6379
RABBITMQ_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF=2

# Backend Configuration
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
TRACING_ENABLED=true
OTEL_SERVICE_NAME=smarthire-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
HEALTHCHECK_TIMEOUT_SECONDS=5
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=your_grafana_admin_user
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password
JAEGER_UI_HOST_PORT=16686
JAEGER_OTLP_GRPC_HOST_PORT=4317
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_BYTES=10485760
JD_UPLOAD_DIR=uploads/job_descriptions
MAX_JD_SIZE_BYTES=10485760
MAX_APPLICATIONS_PER_CANDIDATE=5

# Database Connection URL
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@postgres:5432/smarthire
