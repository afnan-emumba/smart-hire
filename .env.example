# PostgreSQL Configuration
POSTGRES_DB=smarthire
POSTGRES_USER=smarthire
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# Gateway and Temporal
NGINX_PORT=80
TEMPORAL_UI_PORT=8080
TEMPORAL_NAMESPACE=default

# Shared Application Configuration
APP_ENV=development
HTTP_CLIENT_TIMEOUT_SECONDS=5.0

# Per-service Databases
USER_DATABASE_URL=postgresql+asyncpg://smarthire:password@postgres:5432/user_db
JOB_DATABASE_URL=postgresql+asyncpg://smarthire:password@postgres:5432/job_db
RESUME_DATABASE_URL=postgresql+asyncpg://smarthire:password@postgres:5432/resume_db
APPLICATION_DATABASE_URL=postgresql+asyncpg://smarthire:password@postgres:5432/application_db
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://smarthire:password@postgres:5432/notification_db

# File Upload and Business Limits
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_BYTES=10485760
JD_UPLOAD_DIR=uploads/job_descriptions
MAX_JD_SIZE_BYTES=10485760
MAX_APPLICATIONS_PER_CANDIDATE=5
