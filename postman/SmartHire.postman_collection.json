    {
      "name": "Job Publishing Workflow",
      "item": [
        {
          "name": "Create Job",
          "description": "Creates a draft job using recruiter-bound auth context. The request intentionally omits recruiter_id and status because both are server-controlled.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job created as draft', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('draft');",
                  "    pm.expect(body).to.have.property('description_breakdown');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{recruiterUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "RECRUITER"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"description\": \"Location: Hybrid (Lahore, Pakistan)\\nJob Type: Full-Time\\nDepartment: Engineering\\nJob Description\\nWe are looking for a Backend Engineer to design reliable APIs and workflow-driven services.\\n\\n## Responsibilities\\n- Build async backend services with FastAPI and PostgreSQL.\\n- Own integrations with Temporal and Docker-based development workflows.\\n\\n## Requirements\\n- 3+ years of experience in backend engineering.\\n- Strong Python and SQL experience.\\n- Experience with Docker and service-oriented systems.\\n\\n## Benefits\\n- Health insurance\\n- Flexible hybrid schedule\",\n  \"employment_type\": \"full_time\",\n  \"seniority_level\": \"mid\",\n  \"department\": \"Engineering\",\n  \"job_category\": \"Backend Engineering\",\n  \"location\": {\n    \"city\": \"Lahore\",\n    \"country\": \"Pakistan\",\n    \"remote_policy\": \"hybrid\"\n  },\n  \"years_of_experience_required\": 3,\n  \"required_skills\": [\"Python\", \"SQL\", \"Docker\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs"
              ]
            }
          }
        },
        {
          "name": "Update Job",
          "description": "Edits a draft job's title/description/requirements. Only allowed while the job is in draft status \u2014 editing after publish returns 400.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job updated', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().years_of_experience_required).to.equal(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{recruiterUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "RECRUITER"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"years_of_experience_required\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        },
        {
          "name": "Upload Job Description File",
          "description": "Optional validation path for PDF-backed job descriptions. Use this only when you want to test jd_parsing_status moving from pending to processing through the Temporal workflow.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{recruiterUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "RECRUITER"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "description_file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/description-file",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "description-file"
              ]
            }
          }
        },
        {
          "name": "Publish Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Publish returns accepted response', function () {",
                  "    pm.expect(pm.response.code).to.equal(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('workflowId', body.workflow_id);",
                  "pm.test('Publish response includes workflow id', function () {",
                  "    pm.expect(body.workflow_id).to.be.a('string').and.not.empty;",
                  "    pm.expect(['processing', 'ready']).to.include(body.status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{recruiterUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "RECRUITER"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "publish"
              ]
            }
          }
        },
        {
          "name": "Get Job",
          "description": "Run this after Publish Job to verify that the job reaches ready state and that the normalized breakdown remains available.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job retrieved successfully', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Job has workflow-ready fields', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(['processing', 'ready']).to.include(body.status);",
                  "    pm.expect(body).to.have.property('description_breakdown');",
                  "    pm.expect(body).to.have.property('jd_parsing_status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{recruiterUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "RECRUITER"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        },
        {
          "name": "Get Job Status History",
          "description": "Run this after Publish Job to inspect the recorded draft/processing/ready status transitions.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status history retrieved successfully', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Status history is a non-empty array of transitions', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(body[0]).to.have.property('to_status');",
                  "    pm.expect(body[0]).to.have.property('changed_at');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{recruiterUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "RECRUITER"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/status-history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "status-history"
              ]
            }
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{recruiterUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "RECRUITER"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs?limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Application Workflow",
      "item": [
        {
          "name": "Upload Resume",
          "description": "Uploads a PDF resume directly to resume-service (independent of any application). Parsing runs asynchronously via the ResumeParsingWorkflow (Temporal); structured_data/parsing_status populate once the worker finishes.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resume uploaded', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('resumeId', body.id);",
                  "pm.test('Resume response matches contract', function () {",
                  "    pm.expect(body.candidate_id).to.equal(pm.collectionVariables.get('candidateId'));",
                  "    pm.expect(body).to.have.property('parsing_status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{candidateUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "CANDIDATE"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resume",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes"
              ]
            }
          }
        },
        {
          "name": "Get Resume",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{candidateUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "CANDIDATE"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes",
                "{{resumeId}}"
              ]
            }
          }
        },
        {
          "name": "List Resumes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{candidateUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "CANDIDATE"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes?candidate_id={{candidateId}}&limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes"
              ],
              "query": [
                {
                  "key": "candidate_id",
                  "value": "{{candidateId}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Create Application",
          "description": "Creates an application only after the job is publishable. The candidate identity is taken from X-User-ID, and the response should match the documented ApplicationResponse contract. Returns 400 when the candidate has reached the active application limit configured by MAX_APPLICATIONS_PER_CANDIDATE.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('applicationId', body.id);",
                  "pm.test('Application is pending and matches response contract', function () {",
                  "    pm.expect(body.status).to.equal('pending');",
                  "    pm.expect(body).to.have.property('metadata').that.is.an('object');",
