{
  "info": {
    "name": "SmartHire Backend Validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API validation flow for SmartHire."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost/api/v1" },
    { "key": "gatewayUrl", "value": "http://localhost" },
    { "key": "temporalUiUrl", "value": "http://localhost:8080" },
    { "key": "recruiterUserId", "value": "{{$randomUUID}}" },
    { "key": "candidateUserId", "value": "{{$randomUUID}}" },
    { "key": "recruiterId", "value": "" },
    { "key": "candidateId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "workflowId", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "resumeId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Gateway liveness check (nginx itself, no backend dependency) plus per-service deep health checks (each proxies to that service's own DB-connectivity check).",
      "item": [
        {
          "name": "Gateway Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway is up', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().status).to.equal('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Recruiter Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/recruiter",
              "host": ["{{baseUrl}}"],
              "path": ["health", "recruiter"]
            }
          }
        },
        {
          "name": "Candidate Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/candidate",
              "host": ["{{baseUrl}}"],
              "path": ["health", "candidate"]
            }
          }
        },
        {
          "name": "Job Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/job",
              "host": ["{{baseUrl}}"],
              "path": ["health", "job"]
            }
          }
        },
        {
          "name": "Resume Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/resume",
              "host": ["{{baseUrl}}"],
              "path": ["health", "resume"]
            }
          }
        },
        {
          "name": "Application Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/application",
              "host": ["{{baseUrl}}"],
              "path": ["health", "application"]
            }
          }
        },
        {
          "name": "Notification Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/notification",
              "host": ["{{baseUrl}}"],
              "path": ["health", "notification"]
            }
          }
        }
      ]
    },
    {
      "name": "Setup Data",
      "item": [
        {
          "name": "Create Recruiter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recruiter created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('recruiterId', body.id);",
                  "pm.collectionVariables.set('recruiterUserId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@example.com\",\n  \"name\": \"HR Manager\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recruiters",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters"]
            }
          }
        },
        {
          "name": "Create Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('candidateId', body.id);",
                  "pm.collectionVariables.set('candidateUserId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@example.com\",\n  \"name\": \"Software Developer\",\n  \"master_profile_data\": {\n    \"summary\": \"Backend engineer with experience building async APIs and workflow integrations.\",\n    \"skills\": [\"Python\", \"SQL\", \"Docker\"],\n    \"contact\": {\n      \"phone\": \"+1-555-0198\",\n      \"location\": \"Islamabad, PK\"\n    },\n    \"education\": [\n      {\n        \"institution\": \"State University\",\n        \"degree\": \"BSc\",\n        \"field_of_study\": \"Computer Science\",\n        \"start_year\": 2018,\n        \"end_year\": 2022\n      }\n    ],\n    \"work_experience\": [\n      {\n        \"company\": \"Acme Corp\",\n        \"title\": \"Software Engineer\",\n        \"start_year\": 2022,\n        \"end_year\": 2024,\n        \"description\": \"Built recruiter and candidate workflow APIs.\"\n      }\n    ],\n    \"links\": {\n      \"linkedin\": \"https://www.linkedin.com/in/example\",\n      \"github\": \"https://github.com/example\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/candidates",
              "host": ["{{baseUrl}}"],
              "path": ["candidates"]
            }
          }
        },
        {
          "name": "Get Recruiter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recruiters/{{recruiterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters", "{{recruiterId}}"]
            }
          }
        },
        {
          "name": "Get Candidate",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        },
        {
          "name": "List Recruiters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/recruiters?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["recruiters"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Update Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate updated', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().name).to.equal('Senior Software Developer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Senior Software Developer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Job Publishing Workflow",
      "item": [
        {
          "name": "Create Job",
          "description": "Creates a draft job using recruiter-bound auth context. The request intentionally omits recruiter_id and status because both are server-controlled.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job created as draft', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('draft');",
                  "    pm.expect(body).to.have.property('description_breakdown');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"description\": \"Location: Hybrid (Lahore, Pakistan)\\nJob Type: Full-Time\\nDepartment: Engineering\\nJob Description\\nWe are looking for a Backend Engineer to design reliable APIs and workflow-driven services.\\n\\n## Responsibilities\\n- Build async backend services with FastAPI and PostgreSQL.\\n- Own integrations with Temporal and Docker-based development workflows.\\n\\n## Requirements\\n- 3+ years of experience in backend engineering.\\n- Strong Python and SQL experience.\\n- Experience with Docker and service-oriented systems.\\n\\n## Benefits\\n- Health insurance\\n- Flexible hybrid schedule\",\n  \"employment_type\": \"full_time\",\n  \"seniority_level\": \"mid\",\n  \"department\": \"Engineering\",\n  \"job_category\": \"Backend Engineering\",\n  \"location\": {\n    \"city\": \"Lahore\",\n    \"country\": \"Pakistan\",\n    \"remote_policy\": \"hybrid\"\n  },\n  \"years_of_experience_required\": 3,\n  \"required_skills\": [\"Python\", \"SQL\", \"Docker\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        },
        {
          "name": "Update Job",
          "description": "Edits a draft job's title/description/requirements. Only allowed while the job is in draft status — editing after publish returns 400.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job updated', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().years_of_experience_required).to.equal(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"years_of_experience_required\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Upload Job Description File",
          "description": "Optional validation path for PDF-backed job descriptions. Use this only when you want to test jd_parsing_status moving from pending to processing through the Temporal workflow.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "description_file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/description-file",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "description-file"]
            }
          }
        },
        {
          "name": "Publish Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Publish returns accepted response', function () {",
                  "    pm.expect(pm.response.code).to.equal(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('workflowId', body.workflow_id);",
                  "pm.test('Publish response includes workflow id', function () {",
                  "    pm.expect(body.workflow_id).to.be.a('string').and.not.empty;",
                  "    pm.expect(['processing', 'ready']).to.include(body.status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}", "publish"]
            }
          }
        },
        {
          "name": "Get Job",
          "description": "Run this after Publish Job to verify that the job reaches ready state and that the normalized breakdown remains available.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Job retrieved successfully', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Job has workflow-ready fields', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(['processing', 'ready']).to.include(body.status);",
                  "    pm.expect(body).to.have.property('description_breakdown');",
                  "    pm.expect(body).to.have.property('jd_parsing_status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Application Workflow",
      "item": [
        {
          "name": "Upload Resume",
          "description": "Uploads a PDF resume directly to resume-service (independent of any application). Parsing runs asynchronously via the ResumeParsingWorkflow (Temporal); structured_data/parsing_status populate once the worker finishes.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resume uploaded', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('resumeId', body.id);",
                  "pm.test('Resume response matches contract', function () {",
                  "    pm.expect(body.candidate_id).to.equal(pm.collectionVariables.get('candidateId'));",
                  "    pm.expect(body).to.have.property('parsing_status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "resume", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": ["{{baseUrl}}"],
              "path": ["resumes"]
            }
          }
        },
        {
          "name": "Get Resume",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", "{{resumeId}}"]
            }
          }
        },
        {
          "name": "List Resumes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes?candidate_id={{candidateId}}&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["resumes"],
              "query": [
                { "key": "candidate_id", "value": "{{candidateId}}" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Create Application",
          "description": "Creates an application only after the job is publishable. The candidate identity is taken from X-User-ID, and the response should match the documented ApplicationResponse contract. Returns 400 when the candidate has reached the active application limit configured by MAX_APPLICATIONS_PER_CANDIDATE.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('applicationId', body.id);",
                  "pm.test('Application is pending and matches response contract', function () {",
                  "    pm.expect(body.status).to.equal('pending');",
                  "    pm.expect(body).to.have.property('metadata').that.is.an('object');",
                  "    pm.expect(body).to.have.property('resume_id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{jobId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Create Duplicate Application",
          "description": "Replays the same application request to verify duplicate protection. The implemented service raises 409 Conflict for duplicate submissions.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate application rejected', function () {",
                  "    pm.expect(pm.response.code).to.equal(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{jobId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "List Pending Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?status=pending&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Application retrieved', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Application shows workflow metadata', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.metadata).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}"]
            }
          }
        },
        {
          "name": "Update Application Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recruiter can move application to screening', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('screening');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"screening\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "status"]
            }
          }
        },
        {
          "name": "List Screening Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?status=screening&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                { "key": "status", "value": "screening" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Temporal UI Inspection",
      "description": "Manual verification folder for Day 5. Use the stored workflowId to inspect the job publishing workflow in the Temporal UI.",
      "item": [
        {
          "name": "Temporal UI Root",
          "description": "Open the Temporal UI and search for the workflow stored in {{workflowId}}. Confirm the workflow history contains the publish activities and no unresolved failures.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{temporalUiUrl}}",
              "host": ["{{temporalUiUrl}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "description": "Deleting a job or candidate now cascades server-side (job-service/candidate-service call application-service and resume-service internally), so the bulk-delete requests below are optional direct checks of those endpoints rather than required steps.",
      "item": [
        {
          "name": "Delete Applications For Job",
          "description": "Bulk-deletes all applications tied to a job. Called internally by job-service before it deletes the job itself.",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?job_id={{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [{ "key": "job_id", "value": "{{jobId}}" }]
            }
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{recruiterUserId}}" },
              { "key": "X-User-Role", "value": "RECRUITER" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Delete Resumes For Candidate",
          "description": "Bulk-deletes all resumes belonging to a candidate. Called internally by candidate-service before it deletes the candidate itself.",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes?candidate_id={{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["resumes"],
              "query": [{ "key": "candidate_id", "value": "{{candidateId}}" }]
            }
          }
        },
        {
          "name": "Delete Applications For Candidate",
          "description": "Bulk-deletes all applications belonging to a candidate. Called internally by candidate-service before it deletes the candidate itself.",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?candidate_id={{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [{ "key": "candidate_id", "value": "{{candidateId}}" }]
            }
          }
        },
        {
          "name": "Delete Candidate",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{candidateUserId}}" },
              { "key": "X-User-Role", "value": "CANDIDATE" }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["candidates", "{{candidateId}}"]
            }
          }
        }
      ]
    }
  ]
}
