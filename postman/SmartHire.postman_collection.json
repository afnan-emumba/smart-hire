    {
      "name": "Cleanup",
      "description": "Deleting a job or candidate now cascades server-side (job-service/user-service call application-service and resume-service internally), so the bulk-delete requests below are optional direct checks of those endpoints rather than required steps.",
      "item": [
        {
          "name": "Delete Applications For Job",
          "description": "Bulk-deletes all applications tied to a job. Called internally by job-service before it deletes the job itself.",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-ID",
