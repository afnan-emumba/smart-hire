        {
          "name": "Delete Job (202 -> JobDeletionWorkflow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cascade accepted (202)', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('deletionWorkflowId', body.workflow_id);",
                  "pm.test('resource is marked deleting', function () {",
                  "    pm.expect(body.deletion_state).to.eql('deleting');",
                  "});"
                ]
              }
            }
