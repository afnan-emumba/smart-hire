{
  "info": {
    "name": "SmartHire Backend Validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API validation flow for SmartHire."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/api/v1"
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost"
    },
    {
      "key": "temporalUiUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "recruiterUserId",
      "value": "{{$randomUUID}}"
    },
    {
      "key": "candidateUserId",
      "value": "{{$randomUUID}}"
    },
    {
      "key": "recruiterId",
      "value": ""
    },
    {
      "key": "candidateId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "workflowId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "resumeId",
      "value": ""
    },
    {
      "key": "deletionWorkflowId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Gateway liveness check (nginx itself, no backend dependency) plus per-service deep health checks (each proxies to that service's own DB-connectivity check).",
      "item": [
        {
          "name": "Gateway Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway is up', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(pm.response.json().status).to.equal('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "User Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "user"
              ]
            }
          }
        },
        {
          "name": "Job Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/job",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "job"
              ]
            }
          }
        },
        {
          "name": "Resume Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/resume",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "resume"
              ]
            }
          }
        },
        {
          "name": "Application Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/application",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "application"
              ]
            }
          }
        },
        {
          "name": "Notification Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/notification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "notification"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Setup Data",
      "item": [
        {
          "name": "Create Recruiter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recruiter created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('recruiterId', body.id);",
                  "pm.collectionVariables.set('recruiterUserId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-ID",
                "value": "{{recruiterUserId}}"
              },
              {
                "key": "X-User-Role",
                "value": "RECRUITER"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@example.com\",\n  \"name\": \"HR Manager\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recruiters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recruiters"
              ]
            }
          }
        },
        {
          "name": "Create Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
